# ==============================================================================
# SDDS Smart Diaper Disposal & Vending System Environment Configuration
# ==============================================================================

# Shared Database Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=sdds_db

# Cryptographic Salt Key for HMAC Barcode & Token Signing (Rule 8)
SDDS_HMAC_SECRET=your_production_secure_hmac_secret_here_32bytes_min

# Vending Machine Configuration
VENDING_PORT=4000
MACHINE_ID=VM-KGP-01
HARDWARE_MODE=mock # 'mock' for local simulation, 'serial' for physical ESP32
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=115200
SESSION_TIMEOUT_SECONDS=60

# Stripe Payment Gateway (Card Payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here

# Razorpay Payment Gateway (UPI, QR, Cards & NetBanking)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Collection Bin Configuration
BIN_PORT=4001
BIN_ID=BIN-KGP-01
LOAD_CELL_CALIBRATION_FACTOR=420.0 # HX711 calibration slope factor
THERMAL_PRINTER_MODE=mock # 'mock' or 'serial' / 'usb'
PRINTER_PORT=COM4
PRINTER_BAUD_RATE=9600
OTP_PROVIDER=mock # 'mock' or 'fast2sms' / 'twilio'
OTP_EXPIRY_SECONDS=120
REWARD_EXPIRY_DAYS=7

